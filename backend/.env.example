SECRET_KEY=replace-with-a-local-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Produção: prefira a URL fornecida pelo PostgreSQL gerenciado.
DATABASE_URL=

# Configure these values to use PostgreSQL. Without DB_NAME, local SQLite is used.
DB_NAME=reservas_laboratorios
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Comece com 0. Ative HSTS somente depois de validar todos os domínios em HTTPS.
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO
